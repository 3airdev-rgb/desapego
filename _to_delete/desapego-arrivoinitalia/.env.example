# Copie para .env e preencha. Nunca versione o arquivo .env.

# Porta HTTP da aplicação
PORT=3111

# Endereço público (sem barra final). Produção: https://desapego.arrivoinitalia.com
# Desenvolvimento local: http://localhost:3111
PUBLIC_BASE_URL=https://desapego.arrivoinitalia.com

# Senha do painel administrativo (obrigatória)
ADMIN_PASSWORD=troque-esta-senha

# Pasta de dados (banco SQLite e fotos). Em produção, use um caminho fora do código.
DATA_DIR=./data

# Horas que o interessado mantém a reserva
RESERVA_HORAS=48

# WhatsApp do vendedor, com DDI e DDD, sem símbolos
WHATSAPP_NUMERO=5548984443883

# Pix à vista com chave estática (conta Inter)
PIX_CHAVE=
PIX_NOME=CLEO M GARCIA
PIX_CIDADE=FLORIANOPOLIS

# Mercado Pago (parcelado em até 6x, custo repassado ao comprador)
# Credencial de teste para desenvolvimento; produção usa a credencial de produção.
MP_ACCESS_TOKEN=
# Percentual total retido pelo Mercado Pago na venda parcelada em 6x, incluindo antecipação.
# Informe o valor conforme o painel do Mercado Pago. Sem ele, o cartão parcelado fica desativado.
MP_CUSTO_PARCELADO_PCT=
