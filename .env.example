# Copie para .env e preencha. Nunca versione o arquivo .env.

# Porta HTTP da aplicação
PORT=3111

# Endereço público (sem barra final). Produção: https://desapego.arrivoinitalia.com
# Desenvolvimento local: http://localhost:3111
PUBLIC_BASE_URL=https://desapego.arrivoinitalia.com

# Senha do painel administrativo (obrigatória)
ADMIN_PASSWORD=troque-esta-senha

# Pasta de dados (banco SQLite e fotos). Em produção, use um caminho fora do código.
DATA_DIR=./data

# Horas que o interessado mantém a reserva
RESERVA_HORAS=48

# WhatsApp do vendedor, com DDI e DDD, sem símbolos
WHATSAPP_NUMERO=5548984443883

# Pix à vista com chave estática (conta Inter)
PIX_CHAVE=
PIX_NOME=CLEO M GARCIA
PIX_CIDADE=FLORIANOPOLIS

# Mercado Pago (parcelado em até 6x, custo repassado ao comprador)
# Credencial de teste para desenvolvimento; produção usa a credencial de produção.
MP_ACCESS_TOKEN=
# Taxa total (%) por número de parcelas, repassada ao comprador (formato n:pct,n:pct...).
# Padrão = 4,98% (crédito, recebimento na hora) + taxa de parcelamento do Mercado Pago.
# Confira no simulador do Mercado Pago e ajuste se necessário.
# MP_TAXAS_PARCELAS=1:4.98,2:7.51,3:9.6,4:11.67,5:13.64,6:14.94

# Quem calcula os juros do parcelamento no cartão:
#   comprador (padrão) -> o Mercado Pago calcula e cobra os juros do comprador no checkout
#   embutido           -> o site calcula cada parcela (exige parcelamento sem acréscimo na conta MP)
# MP_MODO_JUROS=comprador
# No modo comprador, o site envia o preço do produto e o Mercado Pago calcula o resto: a tarifa
# (4,98% na hora) sai do vendedor. Com 'sim', o site soma a tarifa de 1x ao valor enviado.
# MP_REPASSAR_TARIFA=nao

# --- Cartão por link de pagamento do Mercado Pago (padrão) ---
# Cada produto recebe seu link no painel admin. O site mostra, num pop-up, os valores do simulador do
# Mercado Pago (Link de pagamento, cartão de crédito): à vista = preço do Pix / (1 - tarifa);
# parcelado = juros do comprador sobre o valor à vista.
# LINK_TARIFA_PCT=4.98
# Juros de 2x a 5x já vêm do exemplo (9,64 / 11,23 / 11,36 / 14,31). Informe o de 6x:
# LINK_JUROS_6X=
# Ou todos: LINK_JUROS_PARCELAS=2:9.64,3:11.23,4:11.36,5:14.31,6:0
